LV2_ADMIN_USER=admin
LV2_ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI
HOSTSTORM_SECRET_KEY=GERE_UMA_CHAVE_ALEATORIA_LONGA_AQUI

# Sessão / proxy HTTPS
HOSTSTORM_COOKIE_SECURE=0

# Upload e schedulers
LV2_MAX_UPLOAD_GB=40
LV2_SCHEDULER_GRACE_SECONDS=120
LV2_SCHEDULER_INTERVAL_SECONDS=5
LV2_SUPERVISOR_INTERVAL_SECONDS=5

# Professional services
HOSTSTORM_WATCH_ENABLED=1
HOSTSTORM_WATCH_INTERVAL_SECONDS=30
HOSTSTORM_RETENTION_HOUR=3
HOSTSTORM_BACKUP_HOUR=4
HOSTSTORM_LOG_RETENTION_DAYS=30
HOSTSTORM_BACKUP_KEEP=20
HOSTSTORM_RECORDING_RETENTION_DAYS=30
HOSTSTORM_CLIP_RETENTION_DAYS=60
HOSTSTORM_PLATFORM_API_INTERVAL_SECONDS=60
HOSTSTORM_CPU_ALERT=92
HOSTSTORM_RAM_ALERT=92
HOSTSTORM_DISK_ALERT=90

# Stable / beta
HOSTSTORM_UPDATE_CHANNEL=stable
# HOSTSTORM_GIT_SHA pode ser injetado no deploy se desejar.
